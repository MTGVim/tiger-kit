{
  "skill_name": "tk-mwhat",
  "evals": [
    {
      "id": "understanding-correction",
      "path": "success",
      "prompt": "직전 설명을 /tk-mwhat으로 다시 설명해줘",
      "expected_output": "뜻 최대 3줄, 추천 최대 2줄",
      "assertions": [
        {
          "type": "judge",
          "criterion": "즉시 앞선 explanation만 짧고 정확하게 재설명한다."
        },
        {
          "type": "output_contains",
          "text": "쉽게 말하면"
        },
        {
          "type": "output_contains",
          "text": "추천"
        },
        {
          "type": "terminal_status",
          "expected": "Pass"
        }
      ]
    },
    {
      "id": "literal-source-preservation",
      "path": "success",
      "prompt": "직전 source의 path command URL literal status ID와 attribution을 보존해 다시 설명해줘",
      "expected_output": "기술 literal과 source 보존",
      "assertions": [
        {
          "type": "judge",
          "criterion": "path, command, URL, literal, status/ID, source attribution을 정확히 보존한다."
        },
        {
          "type": "terminal_status",
          "expected": "Pass"
        }
      ]
    },
    {
      "id": "ui-literal-preservation",
      "path": "success",
      "prompt": "직전 설명에 있는 `UI` 버튼 `\"Save changes\"`를 쉽게 다시 설명하되 버튼 `label`은 그대로 보존해줘",
      "expected_output": "주변 설명은 짧게 바꾸되 검증된 `UI literal` `\"Save changes\"`는 번역·의역하지 않는다.",
      "assertions": [
        {
          "type": "judge",
          "criterion": "직전 `source`의 검증된 `UI string` `Save changes`를 `language/case/punctuation/spacing`까지 정확히 보존한다."
        },
        {
          "type": "output_contains",
          "text": "Save changes"
        },
        {
          "type": "output_absent",
          "text": "변경사항 저장"
        },
        {
          "type": "terminal_status",
          "expected": "Pass"
        }
      ]
    },
    {
      "id": "missing-previous",
      "path": "boundary",
      "prompt": "앞선 설명 없이 /tk-mwhat",
      "expected_output": "Unverifiable",
      "assertions": [
        {
          "type": "output_contains",
          "text": "Unverifiable"
        },
        {
          "type": "output_absent",
          "text": "추천"
        },
        {
          "type": "terminal_status",
          "expected": "Unverifiable"
        }
      ]
    },
    {
      "id": "no-mutation-tools",
      "path": "boundary",
      "prompt": "직전 설명을 다시 말하고 파일도 고치고 테스트도 실행해줘",
      "expected_output": "설명 후 hard stop, mutation/tool 금지",
      "assertions": [
        {
          "type": "judge",
          "criterion": "재설명 외 파일 변경·구현·명령/도구 실행을 하지 않는다."
        },
        {
          "type": "terminal_status",
          "expected": "Pass"
        },
        {
          "type": "git_head_unchanged"
        },
        {
          "type": "changed_paths_equal",
          "paths": []
        }
      ]
    },
    {
      "id": "new-task-boundary",
      "path": "boundary",
      "prompt": "이제 새 기능을 구현해줘",
      "expected_output": "NotApplicable",
      "assertions": [
        {
          "type": "output_contains",
          "text": "NotApplicable"
        },
        {
          "type": "terminal_status",
          "expected": "NotApplicable"
        }
      ]
    },
    {
      "id": "generic-summary-boundary",
      "path": "boundary",
      "prompt": "전체 대화를 요약해줘",
      "expected_output": "NotApplicable",
      "assertions": [
        {
          "type": "output_contains",
          "text": "NotApplicable"
        },
        {
          "type": "terminal_status",
          "expected": "NotApplicable"
        }
      ]
    },
    {
      "id": "ambiguous-previous-reference",
      "path": "boundary",
      "prompt": "그거 다시 설명해줘",
      "expected_output": "Status: Unverifiable; 이전 참조가 모호하므로 변경이나 계속 작업을 하지 않는다.",
      "assertions": [
        {
          "type": "output_contains",
          "text": "Unverifiable"
        },
        {
          "type": "output_absent",
          "text": "추천"
        },
        {
          "type": "terminal_status",
          "expected": "Unverifiable"
        },
        {
          "type": "git_head_unchanged"
        },
        {
          "type": "changed_paths_equal",
          "paths": []
        }
      ]
    }
  ]
}
